TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_TIMEZONE=Europe/Moscow
COLLECT_INTERVAL_MINUTES=60
COLLECT_START_HOUR=10
COLLECT_START_MINUTE=0
COLLECT_END_HOUR=20
COLLECT_END_MINUTE=59
FINAL_COLLECT_HOUR=20
FINAL_COLLECT_MINUTE=40
PREPARE_HOUR=20
PREPARE_MINUTE=45
SUMMARY_HOUR=21
SUMMARY_MINUTE=0
LLM_PROVIDER=yandex

# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional. Example: gpt://<folder_id>/yandexgpt-lite/latest
YANDEX_MODEL_URI=
YANDEX_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Lite
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional. Set to false only if you understand the TLS risks.
GIGACHAT_VERIFY_SSL_CERTS=true
# Optional path to CA bundle if your system store is missing the required certs.
GIGACHAT_CA_BUNDLE_FILE=
